APP_NAME="Open to Work"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FALLBACK_LOCALE=en
APP_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=opentowork
DB_USERNAME=opentowork
DB_PASSWORD=opentowork

# Cache, Queue, Session
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Auth
# Quando false, /register auto-loga e /login não bloqueia conta sem verificação.
# Útil até configurar provedor de e-mail (Resend) em prod.
AUTH_EMAIL_VERIFICATION=true

# Mail
# Dev: MailHog (UI em http://localhost:8025) — MAIL_HOST=mailhog é injetado pelo docker-compose
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@opentowork.app.br"
MAIL_FROM_NAME="${APP_NAME}"

# Prod: Resend (https://resend.com) — trocar MAIL_MAILER=resend e preencher RESEND_KEY
# Domínio precisa estar verificado no painel da Resend (SPF + DKIM + DMARC nos DNS)
RESEND_KEY=

# Scout (database driver: usa Postgres LIKE/ILIKE direto, sem servico extra)
SCOUT_DRIVER=database

# Storage (MinIO em dev / R2 em prod)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=opentowork
AWS_SECRET_ACCESS_KEY=opentowork_minio
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=opentowork
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://127.0.0.1:9000/opentowork

# OAuth (preencher com credenciais reais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/auth/linkedin/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Sentry (opcional em dev; sem DSN o pacote é no-op)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Job Aggregators
AGGREGATOR_SCHEDULE_CRON="0 */6 * * *"
AGGREGATOR_SOURCES="remote_ok,arbeitnow,remotive,we_work_remotely,github_vagas"
# Personal Access Token p/ GitHubVagasDriver (opcional; sem token: 60 req/h, com: 5000 req/h).
GITHUB_TOKEN=

# Asaas (pagamento PIX recorrente — plano Pro R$ 25/mês). Sandbox em dev.
ASAAS_API_KEY=
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
ASAAS_WEBHOOK_TOKEN=
ASAAS_PRO_VALUE_CENTS=2500

# Suporte (formulário "Preciso de ajuda" da landing)
SUPPORT_EMAIL=zandonacasagrande@gmail.com

VITE_APP_NAME="${APP_NAME}"
