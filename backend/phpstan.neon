includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - config/
        - database/
        - routes/
        - tests/
    level: 8
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder#'
        # larastan não lê o cast do método casts(), então tipa $user->locale como
        # string. Em runtime é o enum SupportedLocale (coluna NOT NULL default
        # pt_BR), logo ->value é seguro. Mesmo caso já baselineado no SetLocale.
        -
            message: '#^Cannot access property \$value on string\.$#'
            paths:
                - app/Listeners/SendSubscriptionConfirmation.php
                - app/Listeners/SendSubscriptionCancellation.php
        # Pest: PHPStan não resolve $this nos closures de teste (mesmo padrão dos
        # outros testes, que ficam no phpstan-baseline.neon).
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall#'
            path: tests/Feature/Subscription/SubscriptionEmailsTest.php
        -
            message: '#Call to an undefined method Mockery\\#'
            path: tests/Feature/Subscription/SubscriptionEmailsTest.php
