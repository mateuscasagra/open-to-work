# ==========================================================================
# backend.env — copie pra ./secrets/backend.env e preencha com valores REAIS
# NUNCA commite o arquivo final (./secrets/ está no .gitignore)
# ==========================================================================

APP_NAME="Open to Work"
APP_ENV=production
APP_KEY=                                 # gere com: docker run --rm ghcr.io/mateuscasagra/open-to-work-backend php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://opentowork.app.br
APP_FALLBACK_LOCALE=en
APP_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

FRONTEND_URL=https://opentowork.app.br
SANCTUM_STATEFUL_DOMAINS=opentowork.app.br,www.opentowork.app.br
SESSION_DOMAIN=.opentowork.app.br
SESSION_SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://opentowork.app.br,https://www.opentowork.app.br

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# Database (postgres é o nome do container na rede otw)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=opentowork
DB_USERNAME=opentowork
DB_PASSWORD=                             # MESMO valor de POSTGRES_PASSWORD em postgres.env

# Cache, Queue, Session
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Auth
# Em prod, deixe true (exige verificação de email). Setar false só se Resend não estiver configurado ainda.
AUTH_EMAIL_VERIFICATION=true

# Mail (Resend)
# Crie conta em https://resend.com, verifique o domínio (SPF + DKIM + DMARC nos DNS Hostinger).
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@opentowork.app.br"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=                              # API key da Resend (re_...)

# Scout (database driver: usa Postgres direto, sem servico extra)
SCOUT_DRIVER=database

# Storage (Cloudflare R2 recomendado, free tier 10GB)
# Crie bucket em dash.cloudflare.com → R2 → Create bucket
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=                       # R2 access key
AWS_SECRET_ACCESS_KEY=                   # R2 secret key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=opentowork
AWS_ENDPOINT=                            # https://<accountid>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=                                 # URL pública do bucket (custom domain ou r2.dev)

# OAuth — preencher quando ativar social login (opcional pra primeira subida)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/auth/linkedin/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Sentry (opcional, mas recomendado em prod)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Job Aggregators
AGGREGATOR_SCHEDULE_CRON="0 */6 * * *"
AGGREGATOR_SOURCES="remote_ok,arbeitnow,remotive,we_work_remotely,gupy"

# Asaas (pagamento PIX recorrente — plano Pro R$ 25/mês)
# Sandbox: https://sandbox.asaas.com/api/v3
# Prod:    https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
ASAAS_WEBHOOK_TOKEN=                # secret compartilhado com painel Asaas (header asaas-access-token)
ASAAS_PRO_VALUE_CENTS=2500

# Suporte (formulário "Preciso de ajuda" da landing)
SUPPORT_EMAIL=zandonacasagrande@gmail.com
